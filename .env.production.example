# Production environment variables to paste into Vercel Project Settings → Environment Variables.
# Set ALL of these for both Production and Preview environments.

# ----------------------------------------------------------------------------
# Database (Supabase) — Settings → Database → Connection string
# ----------------------------------------------------------------------------
# Use the "Transaction" pooler (port 6543) for runtime queries
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Use the "Direct" connection string (port 5432) for prisma migrate
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres"

# ----------------------------------------------------------------------------
# NextAuth — production
# ----------------------------------------------------------------------------
AUTH_SECRET=""                                              # generate with: openssl rand -base64 32
AUTH_URL="https://crm.solarmaintenanceguys.com"
AUTH_TRUST_HOST="true"
APP_URL="https://crm.solarmaintenanceguys.com"

# ----------------------------------------------------------------------------
# Twilio
# ----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=""                                       # AC...
TWILIO_AUTH_TOKEN=""                                        # rotated post-deploy

# ----------------------------------------------------------------------------
# SendGrid
# ----------------------------------------------------------------------------
SENDGRID_API_KEY=""                                         # SG...
SENDGRID_FROM_EMAIL="titius@solarmaintenanceguys.com"
SENDGRID_FROM_NAME="The Solar Maintenance Guys"

# ----------------------------------------------------------------------------
# Webhook callback base — must match the production domain (no trailing slash)
# ----------------------------------------------------------------------------
PUBLIC_WEBHOOK_URL="https://crm.solarmaintenanceguys.com"

# ----------------------------------------------------------------------------
# Vercel Cron — Bearer token expected on /api/campaigns/tick
# (Vercel automatically injects this; you create it in the project settings)
# ----------------------------------------------------------------------------
CRON_SECRET=""                                              # generate with: openssl rand -hex 32

# Optional shared-secret for hand-running ticks (curl)
CAMPAIGN_TICK_TOKEN=""
